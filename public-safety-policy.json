{
  "$schema": "./schemas/public-safety-policy.schema.json",
  "version": 2,
  "publicationMode": "public-only",
  "allowedNavigationTabs": [
    "Start",
    "StackKits",
    "Techstack",
    "SpeechKit",
    "Identity & Access"
  ],
  "allowedExactPages": [
    "index",
    "identity/overview"
  ],
  "allowedPagePrefixes": [
    "guides/stackkits/",
    "stackkits/",
    "techstack/",
    "speechkit/"
  ],
  "excludedDirectories": [
    ".git",
    ".mintlify",
    "node_modules"
  ],
  "forbiddenPathPrefixes": [
    "internal/",
    "operations/",
    "review/",
    "runbooks/"
  ],
  "forbiddenFrontmatterKeys": [
    "auth",
    "authentication",
    "groups",
    "private",
    "restricted"
  ],
  "forbiddenContentPatterns": [
    {
      "id": "operator-secret-name",
      "pattern": "(?i)\\b(?:AUTH0_MCP_BEARER|DOPPLER_(?:CONFIG|PROJECT|TOKEN)|RENDER_API_KEY|REPO_SYNC_PAT)\\b"
    },
    {
      "id": "internal-secret-path",
      "pattern": "(?i)\\b(?:kombination|kombify-systems)/(?:dev|prd|prd_servers|stg)\\b"
    },
    {
      "id": "provider-origin",
      "pattern": "(?i)https?://[^\\s<>()\\\"']+\\.(?:onrender\\.com|pages\\.dev|run\\.app|workers\\.dev)(?:[/:?#]|$)"
    },
    {
      "id": "live-credential-assignment",
      "pattern": "(?im)\\b(?:access[_-]?token|api[_-]?key|client[_-]?secret|password)\\b\\s*[:=]\\s*(?![\\\"']?(?:<|\\$\\{|\\{\\{|example|redacted|replace|your[-_]|x{3,}))[\\\"']?[A-Za-z0-9_./+=-]{12,}"
    },
    {
      "id": "internal-proxmox",
      "pattern": "(?i)\\bproxmox\\b"
    },
    {
      "id": "retired-simulate-product",
      "pattern": "(?i)\\bkombify[ -]?simulate\\b|\\bkombifysim\\b|(?:^|[\\\"'(])/?sim/"
    },
    {
      "id": "unreleased-product-surface",
      "pattern": "(?i)\\bkombify[ -]?(?:cloud|ai|workbench|companion)\\b"
    }
  ],
  "localSmokePaths": [
    "/",
    "/identity/overview",
    "/stackkits/overview",
