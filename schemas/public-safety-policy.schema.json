{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.kombify.io/schemas/public-safety-policy.schema.json",
  "title": "Kombify public documentation safety policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "publicationMode",
    "allowedNavigationTabs",
    "allowedExactPages",
    "allowedPagePrefixes",
    "excludedDirectories",
    "forbiddenPathPrefixes",
    "forbiddenFrontmatterKeys",
    "forbiddenContentPatterns",
    "localSmokePaths",
    "remoteForbiddenPaths",
    "remoteForbiddenMarkers"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 2 },
    "publicationMode": { "const": "public-only" },
    "allowedNavigationTabs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedExactPages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "allowedPagePrefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "/$" }
    },
    "excludedDirectories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenPathPrefixes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "/$" }
    },
    "forbiddenFrontmatterKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" }
    },
    "forbiddenContentPatterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "pattern"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "pattern": { "type": "string", "minLength": 1 }
        }
      }
    },
    "localSmokePaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/" }
    },
    "remoteForbiddenPaths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^/" }
    },
    "remoteForbiddenMarkers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
