{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime",
            "type": "command"
          },
          {
            "type": "command",
            "timeout": 60,
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/kombify-bootstrap.mjs\" --hook || true"
          }
        ],
        "matcher": ""
      }
    ]
  }
}
