{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "kombify",
  "colors": {
    "primary": "#6366F1",
    "light": "#818CF8",
    "dark": "#4F46E5"
  },
  "favicon": "/images/Icon.png",
  "appearance": {
    "default": "dark"
  },
  "search": {
    "prompt": "Search kombify docs..."
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index"]
          }
        ]
      },
      {
        "tab": "StackKits",
        "icon": "boxes-stacked",
        "groups": [
          {
            "group": "Get started",
            "icon": "circle-info",
            "pages": [
              "stackkits/overview",
              "stackkits/quickstart",
              "guides/stackkits/choosing-a-kit"
            ]
          },
          {
            "group": "Kits",
            "icon": "box",
            "pages": [
              "stackkits/kits/basement-kit",
              "stackkits/kits/cloud-kit",
              "stackkits/kits/modern-homelab"
            ]
          },
          {
            "group": "Add-ons",
            "icon": "puzzle-piece",
            "pages": [
              "stackkits/addons/overview",
              "stackkits/addons/high-availability"
            ]
          },
          {
            "group": "How-To",
            "icon": "book-open",
            "pages": [
              "guides/stackkits/local-vs-cloud-vs-hybrid",
              "guides/stackkits/sizing-your-stackkit",
              "guides/stackkits/install-only-vs-managed-cloud",
              "guides/stackkits/add-to-existing-homelab",
              "guides/stackkits/high-availability-readiness",
              "guides/stackkits/from-intent-to-stack-spec",
              "guides/stackkits/deploy-with-cli-or-techstack",
              "guides/stackkits/node-hub"
            ]
          },
          {
            "group": "Applications",
            "icon": "grid-2",
            "root": "stackkits/apps/overview",
            "directory": "card",
            "pages": [
              {
                "group": "Photos",
                "icon": "image",
                "pages": ["stackkits/apps/immich"]
              },
              {
                "group": "Media Streaming",
                "icon": "clapperboard",
                "pages": ["stackkits/apps/jellyfin"]
              },
              {
                "group": "Passwords & Secrets",
                "icon": "key",
                "pages": ["stackkits/apps/vaultwarden"]
              },
              {
                "group": "Monitoring & Observability",
                "icon": "chart-line",
                "pages": ["stackkits/apps/uptime-kuma"]
              },
              {
                "group": "Login & SSO",
                "icon": "right-to-bracket",
                "pages": [
                  "stackkits/apps/pocketid",
                  "stackkits/apps/tinyauth"
                ]
              },
              {
                "group": "PaaS Platforms",
                "icon": "rocket",
                "pages": [
                  "stackkits/apps/coolify",
                  "stackkits/apps/komodo",
                  "stackkits/apps/dokploy",
                  "stackkits/apps/dockge"
                ]
              },
              {
                "group": "Platform Core",
                "icon": "microchip",
                "pages": [
                  "stackkits/apps/traefik",
                  "stackkits/apps/homepage",
                  "stackkits/apps/dozzle",
                  "stackkits/apps/whoami",
                  "stackkits/apps/kombify-point"
                ]
              }
            ]
          },
          {
            "group": "Explanations",
            "icon": "lightbulb",
            "pages": ["stackkits/explanations/cue-architecture"]
          },
          {
            "group": "Reference",
            "icon": "book-bookmark",
            "pages": [
              "stackkits/reference/tool-alternatives",
              "stackkits/reference/spec-format",
              "stackkits/reference/monitoring"
            ]
          }
        ]
      },
      {
        "tab": "Identity & Access",
        "icon": "shield-halved",
        "groups": [
          {
            "group": "Identity & Access",
            "icon": "shield-halved",
            "pages": [
              "identity/overview",
              "identity/architecture",
              "identity/trust-and-security"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "newspaper",
        "groups": [
          {
            "group": "Changelog",
            "pages": ["changelog/overview"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/kombifyio/StackKits",
          "icon": "github"
        },
        {
          "anchor": "Community",
          "href": "https://discord.gg/kombify",
          "icon": "discord"
        },
        {
          "anchor": "Blog",
          "href": "https://blog.kombify.io",
          "icon": "newspaper"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/stackkits/kits/base-kit",
      "destination": "/stackkits/kits/basement-kit"
    },
    {
      "source": "/stackkits/kits/ha-kit",
      "destination": "/stackkits/addons/high-availability"
    },
    {
      "source": "/guides/stackkits/services/portainer",
      "destination": "/stackkits/reference/tool-alternatives"
    },
    {
      "source": "/guides/stackkits/services/netdata",
      "destination": "/stackkits/reference/tool-alternatives"
    },
    {
      "source": "/guides/stackkits/services/beszel",
      "destination": "/stackkits/reference/tool-alternatives"
    },
    {
      "source": "/guides/stackkits/services/:slug*",
      "destination": "/stackkits/apps/:slug*"
    }
  ],
  "logo": {
    "light": "/images/logo_sized.png",
    "dark": "/images/logo_sized.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:info@kombify.io"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.kombify.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/kombifydev",
      "github": "https://github.com/kombifyio",
      "discord": "https://discord.gg/kombify"
    }
  }
}
