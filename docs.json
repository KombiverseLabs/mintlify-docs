  "redirects": [
    { "source": "/api/kombistack/:path*", "destination": "/api/kombifytechstack/:path*" },
    { "source": "/api/kombisim/:path*", "destination": "/api/kombifysim/:path*" },
    { "source": "/api/kombisphere/:path*", "destination": "/api/kombifycloud/:path*" }
