{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "kombify",
  "colors": {
    "primary": "#6366F1",
    "light": "#818CF8",
    "dark": "#4F46E5"
  },
  "favicon": "/images/Icon.png",
  "appearance": {
    "default": "dark"
  },
  "search": {
    "prompt": "Search kombify docs..."
  },
  "redirects": [
    {
      "source": "/identity",
      "destination": "/identity/overview"
    },
    {
      "source": "/products/simulate",
      "destination": "/platform/product-hierarchy"
    },
    {
      "source": "/products/desk",
      "destination": "/platform/retired-surfaces"
    },
    {
      "source": "/stackkits/kits/base-kit",
      "destination": "/stackkits/kits/basement-kit"
    },
    {
      "source": "/cloud",
      "destination": "https://app.kombify.io"
    },
    {
      "source": "/auth",
      "destination": "https://login.kombify.io"
    }
  ],
  "navigation": {
    "tabs": [
      {
        "tab": "Start here",
        "groups": [
          {
            "group": "Platform guide",
            "public": true,
            "pages": [
              "index",
              "platform/overview",
              "journeys/overview"
            ]
          }
        ]
      },
      {
        "tab": "Platform",
        "icon": "layer-group",
        "groups": [
          {
            "group": "Foundation",
            "public": true,
            "pages": [
              "platform/product-hierarchy",
              "platform/operating-modes",
              "platform/oss-core-and-wave1",
              "platform/cloud-and-premium",
              "platform/retired-surfaces"
            ]
          },
          {
            "group": "AI and operations",
            "public": true,
            "pages": [
              "ai/guide",
              "ai/workbench",
              "ai/companion",
              "ai/speechkit",
              "support/support-and-denial-envelopes"
            ]
          },
          {
            "group": "Reference journeys",
            "public": true,
            "pages": [
              "journeys/anonymous-discovery",
              "journeys/oss-local",
              "journeys/connected-free",
              "journeys/paid-operated",
              "journeys/companion-voice"
            ]
          }
        ]
      },
      {
        "tab": "Identity & Access",
        "icon": "shield-halved",
        "groups": [
          {
            "group": "Identity & Access",
            "public": true,
            "icon": "shield-halved",
            "pages": [
              "identity/overview",
              "identity/architecture",
              "identity/trust-and-security"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "newspaper",
        "groups": [
          {
            "group": "Changelog",
            "public": true,
            "pages": ["changelog/overview"]
          }
        ]
      },
      {
        "tab": "StackKits",
        "icon": "boxes-stacked",
        "groups": [
          {
            "group": "Overview",
            "public": true,
            "icon": "circle-info",
            "pages": ["stackkits/overview", "stackkits/quickstart"]
          },
          {
            "group": "Available kits",
            "public": true,
            "icon": "box",
            "pages": [
              "stackkits/kits/basement-kit",
              "stackkits/kits/cloud-kit"
            ]
          },
          {
            "group": "Future kit concepts",
            "public": true,
            "icon": "clock",
            "pages": [
              "stackkits/kits/modern-homelab",
              "stackkits/kits/ha-kit"
            ]
          },
          {
            "group": "How-To",
            "public": true,
            "icon": "book-open",
            "pages": [
              "guides/stackkits/choosing-a-kit",
              "guides/stackkits/local-vs-cloud-vs-hybrid",
              "guides/stackkits/sizing-your-stackkit",
              "guides/stackkits/install-only-vs-managed-cloud",
              "guides/stackkits/add-to-existing-homelab",
              "guides/stackkits/high-availability-readiness",
              "guides/stackkits/from-intent-to-stack-spec",
              "guides/stackkits/deploy-with-cli-or-techstack",
              "guides/stackkits/node-hub"
            ]
          },
          {
            "group": "Use cases",
            "public": true,
            "icon": "diagram-project",
            "pages": [
              "guides/stackkits/use-cases/overview",
              "guides/stackkits/use-cases/family-photo-vault"
            ]
          },
          {
            "group": "Service guides",
            "public": true,
            "icon": "list-check",
            "pages": [
              "guides/stackkits/services/homepage",
              "guides/stackkits/services/pocketid",
              "guides/stackkits/services/tinyauth",
              "guides/stackkits/services/traefik",
              "guides/stackkits/services/dokploy",
              "guides/stackkits/services/coolify",
              "guides/stackkits/services/komodo",
              "guides/stackkits/services/dockge",
              "guides/stackkits/services/portainer",
              "guides/stackkits/services/uptime-kuma",
              "guides/stackkits/services/netdata",
              "guides/stackkits/services/beszel",
              "guides/stackkits/services/dozzle",
              "guides/stackkits/services/whoami",
              "guides/stackkits/services/vaultwarden",
              "guides/stackkits/services/jellyfin",
              "guides/stackkits/services/immich",
              "guides/stackkits/services/kombify-point"
            ]
          },
          {
            "group": "Explanations",
            "public": true,
            "icon": "lightbulb",
            "pages": ["stackkits/explanations/cue-architecture"]
          },
          {
            "group": "Reference",
            "public": true,
            "icon": "book-bookmark",
            "pages": [
              "stackkits/reference/tool-alternatives",
              "stackkits/reference/spec-format",
              "stackkits/reference/monitoring"
            ]
          },
          {
            "group": "Documentation review",
            "public": false,
            "groups": ["kombify-team"],
            "pages": ["review/audience-workflow"]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/kombifyio/stackKits",
          "icon": "github"
        },
        {
          "anchor": "Community",
          "href": "https://discord.gg/kombify",
          "icon": "discord"
        },
        {
          "anchor": "Blog",
          "href": "https://blog.kombify.io",
          "icon": "newspaper"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/logo_sized.png",
    "dark": "/images/logo_sized.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "/support/support-and-denial-envelopes"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.kombify.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/kombifydev",
      "github": "https://github.com/kombifyio",
      "discord": "https://discord.gg/kombify"
    }
  }
}
