# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Agent-facing wiki (not part of the public docs site)
openwiki/

# Repository operations files, not public Mintlify content
AGENTS.md
CLAUDE.md
CONTRIBUTING.md
README.md
ROADMAP.md
STATUS.md
mise.toml
