# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Agent-facing wiki (not part of the public docs site)
openwiki/

# Private delivery compiler checkout (.github/workflows/delivery.yml)
standards/

# Release data the sync scripts render pages from. Stored lifecycle evidence
# keeps names the public-safety policy keeps off this site.
/data/
/localization/

# Issue tracker and delivery configuration
.beads/
.kombify/

# Repository operations files, not public Mintlify content
AGENTS.md
CLAUDE.md
CONTRIBUTING.md
README.md
ROADMAP.md
STATUS.md
mise.toml
public-safety-policy.json
