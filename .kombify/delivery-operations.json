{
  "schema_version": 1,
  "product_id": "docs",
  "repository_id": "mintlify-docs",
  "groups": [
    {
      "id": "public-docs",
      "source_repository": "mintlify-docs",
      "primary_artifact": "public-docs",
      "artifacts": [
        "public-docs"
      ],
      "paths": [
        "**/*.md",
        "docs.json",
        ".kombify/**"
      ],
      "operations": {
        "build": {
          "fast": [
            {
              "task": "check"
            }
          ],
          "stable": [
            {
              "task": "check"
            }
          ]
        },
        "validate": {
          "fast": [
            {
              "task": "local:e2e"
            }
          ],
          "stable": [
            {
              "task": "local:e2e"
            }
          ]
        },
        "publish": {
          "fast": [
            {
              "satisfied": {
                "by": "mintlify:KombiverseLabs/mintlify-docs",
                "reason": "Mintlify's repository integration publishes the exact merged main revision automatically."
              }
            }
          ],
          "stable": [
            {
              "satisfied": {
                "by": "mintlify:KombiverseLabs/mintlify-docs",
                "reason": "Mintlify's repository integration publishes the exact merged main revision automatically."
              }
            }
          ]
        },
        "promote": {
          "fast": [
            {
              "satisfied": {
                "by": "public-docs/publish",
                "reason": "The immutable artifact was activated by the group's authoritative publish adapter."
              }
            }
          ],
          "stable": [
            {
              "satisfied": {
                "by": "public-docs/publish",
                "reason": "The immutable artifact was activated by the group's authoritative publish adapter."
              }
            }
          ]
        },
        "smoke": {
          "fast": [
            {
              "http": "https://docs.kombify.io",
              "expected_statuses": [
                200
              ]
            }
          ],
          "stable": [
            {
              "http": "https://docs.kombify.io",
              "expected_statuses": [
                200
              ]
            }
          ]
        },
        "async": {
          "fast": [
            {
              "satisfied": {
                "by": "scheduled-asynchronous-gates",
                "reason": "Broad compatibility, device, provider, and soak findings remain non-blocking and run in their dedicated scheduled workflows."
              }
            }
          ],
          "stable": [
            {
              "satisfied": {
                "by": "scheduled-asynchronous-gates",
                "reason": "Broad compatibility, device, provider, and soak findings remain non-blocking and run in their dedicated scheduled workflows."
              }
            }
          ]
        }
      }
    }
  ]
}
