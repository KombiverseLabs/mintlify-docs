{
  "schema_version": 1,
  "product_id": "docs",
  "repository_id": "mintlify-docs",
  "groups": [
    {
      "id": "public-docs",
      "source_repository": "mintlify-docs",
      "primary_artifact": "public-docs",
      "artifacts": [
        "public-docs"
      ],
      "paths": [
        "**/*.mdx",
        "docs.json",
        "public-safety-policy.json",
        "schemas/public-safety-policy.schema.json",
        "scripts/**",
        "mise.toml",
        ".kombify/VERSION"
      ],
      "operations": {
        "build": {
          "fast": [
            {
              "command": [
                "node",
                "standards/scripts/mintlify-publication.mjs",
                "build",
                "--repo",
                ".",
                "--source",
                "${SOURCE_SHA}"
              ]
            }
          ],
          "stable": [
            {
              "command": [
                "node",
                "standards/scripts/mintlify-publication.mjs",
                "build",
                "--repo",
                ".",
                "--source",
                "${SOURCE_SHA}"
              ]
            }
          ]
        },
        "validate": {
          "fast": [
            {
              "command": [
                "node",
                "standards/scripts/mintlify-publication.mjs",
                "validate",
                "--repo",
                ".",
                "--source",
                "${SOURCE_SHA}"
              ]
            }
          ],
          "stable": [
            {
              "command": [
                "node",
                "standards/scripts/mintlify-publication.mjs",
                "validate",
                "--repo",
                ".",
                "--source",
                "${SOURCE_SHA}"
              ]
            }
          ]
        },
        "publish": {
          "fast": [
            {
              "command": [
                "node",
                "standards/scripts/mintlify-publication.mjs",
                "publish",
                "--repo",
                ".",
                "--source",
                "${SOURCE_SHA}"
              ]
            }
          ],
          "stable": [
            {
              "command": [
                "node",
                "standards/scripts/mintlify-publication.mjs",
                "publish",
                "--repo",
                ".",
                "--source",
                "${SOURCE_SHA}"
              ]
            }
          ]
        },
        "promote": {
          "fast": [
            {
              "command": [
                "node",
                "standards/scripts/mintlify-publication.mjs",
                "promote",
                "--repo",
                ".",
                "--source",
                "${SOURCE_SHA}"
              ]
            }
          ],
          "stable": [
            {
              "command": [
                "node",
                "standards/scripts/mintlify-publication.mjs",
                "promote",
                "--repo",
                ".",
                "--source",
                "${SOURCE_SHA}"
              ]
            }
          ]
        },
        "smoke": {
          "fast": [
            {
              "command": [
                "node",
                "standards/scripts/mintlify-publication.mjs",
                "smoke",
                "--repo",
                ".",
                "--source",
                "${SOURCE_SHA}"
              ]
            }
          ],
          "stable": [
            {
              "command": [
                "node",
                "standards/scripts/mintlify-publication.mjs",
                "smoke",
                "--repo",
                ".",
                "--source",
                "${SOURCE_SHA}"
              ]
            }
          ]
        },
        "async": {
          "fast": [
            {
              "satisfied": {
                "by": "docs-quality",
                "reason": "Quality checks and M13 hosted acceptance run outside publication."
              }
            }
          ],
          "stable": [
            {
              "satisfied": {
                "by": "docs-quality",
                "reason": "Quality checks and M13 hosted acceptance run outside publication."
              }
            }
          ]
        }
      }
    }
  ]
}
